# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection (get this from mongodb.com/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/vinayak_car_zone?retryWrites=true&w=majority

# JWT Secret (use a long random string in production)
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# Admin Default Credentials (used for seeding)
ADMIN_EMAIL=admin@vinayakcarzone.in
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Admin

# Email Configuration (Gmail example)
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Vinayak Car Zone
SMTP_FROM_EMAIL=your-email@gmail.com

# Admin notification email (where booking notifications are sent)
ADMIN_NOTIFY_EMAIL=helpdesk@vinayakcarzone.in

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
