# ====================================================================
#  Vinayak Car Zone - local environment variables
# ====================================================================
#  Copy this file to `.env` and fill in the values.
#  These are loaded automatically by `netlify dev` for local
#  development, and you must set the same keys in the Netlify
#  dashboard (Site settings -> Environment variables) for production.
# ====================================================================

# ---- REQUIRED ----

# Long random string used to sign JWTs.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_characters

# Admin login for /admin/login.  The admin user is auto-seeded
# into Netlify Blobs on first request, using these credentials.
ADMIN_EMAIL=admin@vinayakcarzone.in
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Admin

# ---- OPTIONAL: email notifications ----
# Without these, bookings are stored but no email is sent.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=Vinayak Car Zone
# SMTP_FROM_EMAIL=your-email@gmail.com
# ADMIN_NOTIFY_EMAIL=helpdesk@vinayakcarzone.in

# ---- OPTIONAL: misc ----
# FRONTEND_URL=https://your-site.netlify.app
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=10
